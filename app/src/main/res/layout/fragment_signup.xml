<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="Tutup"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Lengkapi Detail Akun"
            android:textColor="#000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Info Banner -->
    <LinearLayout
        android:id="@+id/infoBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="#E8F2FF"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Akun yang kamu buat ini bisa dipakai di semua aplikasi di ekosistem Blibli Tiket, lho!"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentang ekosistem Blibli Tiket"
            android:textColor="#2B79F7"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Signup Form -->
    <LinearLayout
        android:id="@+id/signupCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/infoBanner">

        <!-- Full Name -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittext_bg"
            android:hint="Nama lengkap*"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#000"
            android:textColorHint="#8A8A8A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Seperti di KTP/Paspor/SIM."
            android:textColor="#8A8A8A"
            android:textSize="12sp" />

        <!-- Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edittext_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Indonesia Flag"
                android:src="@drawable/ic_indonesia" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+62"
                android:textColor="#000"
                android:textSize="15sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="#E0E0E0" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Nomor HP*"
                android:inputType="phone"
                android:paddingStart="12dp"
                android:textColor="#000"
                android:textColorHint="#8A8A8A"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edittext_bg"
            android:hint="Email*"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="#000"
            android:textColorHint="#8A8A8A"
            android:textSize="15sp" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edittext_bg"
            android:hint="Kata sandi*"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#000"
            android:textColorHint="#8A8A8A"
            android:textSize="15sp" />

        <!-- Password Validation -->
        <LinearLayout
            android:id="@+id/passwordValidationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/password_validation_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">


            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Pastikan kata sandimu memiliki:"
                android:textColor="#333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvUppercase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ Huruf besar"
                android:textColor="#888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLowercase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ Huruf kecil"
                android:textColor="#888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ Angka"
                android:textColor="#888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ 8–50 karakter"
                android:textColor="#888"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Signup Button -->

    <!-- Footer -->

    <Button
        android:id="@+id/btnSignup"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#2B79F7"
        android:text="Daftar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signupCard" />

    <!-- Footer logo -->

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="244dp"
        android:gravity="center"
        android:text="@string/privacy_text"
        android:textColor="#7A7A7A"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSignup" />

</androidx.constraintlayout.widget.ConstraintLayout>
