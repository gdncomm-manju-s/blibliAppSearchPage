<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_bottomsheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Batalkan proses pendaftaran?"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Kalau proses ini dibatalkan, kamu harus mengisi semua detail akunmu dari awal lagi."
        android:textColor="@color/gray"
        android:textSize="14sp" />

    <!-- Button: Ya, batalkan -->
    <Button
        android:id="@+id/btnYes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/light_blue"
        android:text="Ya, batalkan"
        android:textAllCaps="false"
        android:textColor="@color/blue"
        android:textStyle="bold" />

    <!-- Button: Lanjutkan -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/blue"
        android:text="Lanjutkan pendaftaran"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</LinearLayout>
